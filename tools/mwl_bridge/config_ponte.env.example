# ==============================================================================
# CONFIGURAÇÃO LOCAL DA PONTE MWL (LW LAUDOS) - MODELO
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para 'config_ponte.env' na mesma pasta.
# 2. No LW Laudos, acerte sua conta em Configurações -> Worklist DICOM.
# 3. Cole o token no campo LW_MWL_TOKEN abaixo.
# NUNCA envie o arquivo com token real para o Git ou repositório público.
# ==============================================================================

LW_MWL_URL=https://app.lwlaudos.com.br
LW_MWL_TOKEN=COLE_AQUI_SEU_TOKEN_DE_32_CARACTERES
LW_MWL_CLINIC=Mirante da Serra
LW_MWL_INTERVAL=30
LW_MWL_WORKLIST_DIR=./worklists
